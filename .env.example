# Settings for `tspl-label agent`. Copy to .env and load it with your process
# manager, or export the variables in the shell.

# Base URL of the queue (see "Queue contract" in the README). Required.
LABEL_QUEUE_URL=https://example.com/api/label-queue
# Bearer token the queue expects. Required.
LABEL_QUEUE_TOKEN=change-me

# The printer device. When unset, the agent looks for the lp device whose USB
# id matches PRINTER_USB_ID.
#PRINTER_DEVICE=/dev/usb/lp0
#PRINTER_USB_ID=0471:0055

# Gap between labels on the roll, in mm.
#GAP_MM=2
# Dots to move the print across the roll (TSPL REFERENCE x).
#REFERENCE_X=0
# Dots to move the print along the roll (TSPL SHIFT), 0 or more.
#SHIFT_Y=0
# 1 turns the label half a turn so it reads the right way up as it feeds out.
#ROTATE=0
# How often to ask the queue for work, in ms (500 at least).
#POLL_MS=2000
